{
  "rewrites": [
    {
      "source": "/api/hue-discovery/(.*)",
      "destination": "https://discovery.meethue.com/$1"
    },
    {
      "source": "/api/hue-discovery",
      "destination": "https://discovery.meethue.com/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
