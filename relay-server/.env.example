# Lightify Relay Server Configuration

# Shared secret for authenticating requests from the Lightify app
# Generate a secure random string (e.g., openssl rand -hex 32)
RELAY_SECRET=your-secure-random-token-here

# Local IP address of your Philips Hue Bridge
# Find this in the Hue app or at https://discovery.meethue.com
BRIDGE_IP=192.168.1.xxx

# Port for the relay server to listen on
PORT=3001

# Comma-separated list of allowed origins (CORS)
# Include your Vercel deployment URL and localhost for testing
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
